<Application x:Class="BackgroundCut.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BackgroundCut.Desktop.Ui">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <ui:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <SolidColorBrush x:Key="TextBrush" Color="#17202A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#59697A"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
        </Style>
    </Application.Resources>
</Application>
