<Window x:Class="BackgroundCut.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BackgroundCut settings" Width="560" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F6F8FB">
 <StackPanel Margin="28"><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Choose sensible defaults. You can change these at any time." Foreground="#51606F" Margin="0,6,0,24"/><TextBlock Text="When I save" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Policies}" SelectedItem="{Binding Policy}" Margin="0,8,0,4"/><TextBlock Text="{Binding PolicyDescription}" Foreground="#51606F"/><TextBlock Text="Default folder" FontWeight="SemiBold" Margin="0,22,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}"/><TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Padding="8"/></DockPanel><Separator Margin="0,24"/><TextBlock Text="Models" FontWeight="SemiBold"/><TextBlock Text="Fast &amp; accurate is included. Highest quality can be added when model management is connected." TextWrapping="Wrap" Foreground="#51606F" Margin="0,8,0,0"/><Button Content="Manage models…" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Model download is provided by Infrastructure."/><CheckBox Content="Add “Remove background” to Explorer's image menu" IsEnabled="False" Margin="0,18,0,0"/><TextBlock Text="Explorer integration will be enabled by the installer/Infrastructure adapter." FontSize="12" Foreground="#51606F" TextWrapping="Wrap" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0"><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Content="Save settings" Command="{Binding SaveCommand}" IsDefault="True" Background="#2563EB" Foreground="White"/></StackPanel></StackPanel>
</Window>
