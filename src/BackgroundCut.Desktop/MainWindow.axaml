<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:BackgroundCut.Desktop.Ui"
        x:Class="BackgroundCut.Desktop.MainWindow"
        Title="BackgroundCut"
        Icon="/Assets/BackgroundCut.ico"
        MinWidth="1024" MinHeight="680" Width="1320" Height="840"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding ChooseImageCommand}" />
    <KeyBinding Gesture="Meta+O" Command="{Binding ChooseImageCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewImageCommand}" />
    <KeyBinding Gesture="Meta+N" Command="{Binding NewImageCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <Grid Margin="28,24,28,26" RowDefinitions="Auto,*">
    <Grid Margin="2,0,2,20" ColumnDefinitions="Auto,*,Auto">
      <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
        <TextBlock Text="✦" FontSize="23" Foreground="{StaticResource PrimaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="BackgroundCut" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Private background removal, right on your computer" FontSize="13"
                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Settings" Command="{Binding SettingsCommand}" Classes="ghost">
          <ToolTip.Tip>Output, models, and platform integration</ToolTip.Tip>
        </Button>
        <Button Content="+  Add images" Command="{Binding ChooseImageCommand}" Classes="primary">
          <ToolTip.Tip>Choose one or several images</ToolTip.Tip>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,340">
      <Grid Grid.Column="0" Margin="0,0,18,0" RowDefinitions="*,Auto,Auto">
        <Border Grid.Row="0" Classes="card" Padding="22">
          <Grid RowDefinitions="Auto,*">
            <Grid Margin="2,0,2,16" ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedItem.Status}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasResult}">
                <Button Content="Copy" Command="{Binding CopyCommand}" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Save as…" Command="{Binding SaveAsCommand}" Classes="primary" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
              <Border IsVisible="{Binding IsEmpty}" Background="#FFFCF3" BorderBrush="#E7C98F"
                      BorderThickness="1" CornerRadius="16" Padding="30">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                  <Border Width="76" Height="76" CornerRadius="24" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,20">
                    <TextBlock Text="＋" FontSize="38" FontWeight="Light" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="Drop your images here" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Add one image or a whole batch. They’ll process in order and stay in your gallery for 30 days."
                             FontSize="15" LineHeight="23" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                             TextAlignment="Center" Margin="0,10,0,18" />
                  <Button Content="Choose images" Command="{Binding ChooseImageCommand}" IsDefault="True"
                          Classes="primary" HorizontalAlignment="Center" MinWidth="190" />
                  <TextBlock Text="JPG, PNG, WebP, BMP, or TIFF" FontSize="12" Foreground="{StaticResource MutedBrush}"
                             Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <StackPanel IsVisible="{Binding ShowProcessing}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
                <Border Width="66" Height="66" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,18">
                  <TextBlock Text="✦" FontSize="28" Foreground="{StaticResource PrimaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding SelectedItem.Status}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar Height="8" Margin="0,22,0,12" Value="{Binding SelectedItem.Progress, Mode=OneWay}" Maximum="1" />
                <TextBlock Text="{Binding QueueSummary}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <Button Content="Cancel current image" Command="{Binding CancelCommand}" Margin="0,18,0,0" />
              </StackPanel>

              <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
                <Border Width="62" Height="62" CornerRadius="20" Background="#FCE8D8" Margin="0,0,0,18">
                  <TextBlock Text="!" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="This image needs attention" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,14" TextAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="Try again" Command="{Binding RetryCommand}" Classes="primary" />
                  <Button Content="Open Settings" Command="{Binding SettingsCommand}" />
                  <Button Content="Add other images" Command="{Binding ChooseImageCommand}" />
                </StackPanel>
                <Expander Header="Technical details" Margin="0,14,0,0" MaxWidth="560"
                          IsVisible="{Binding ErrorDetails, Converter={StaticResource StringNotEmpty}}">
                  <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" />
                </Expander>
              </StackPanel>

              <Grid IsVisible="{Binding HasResult}">
                <Grid IsVisible="{Binding HasBefore}" ColumnDefinitions="*,*">
                  <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Original" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="{StaticResource MutedBrush}" />
                    <Border Background="#F4E8D2" CornerRadius="14" Padding="10" ClipToBounds="True">
                      <Image Source="{Binding Before}" Stretch="Uniform" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Transparent result" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="{StaticResource MutedBrush}" />
                    <Border Background="#F3E3C7" CornerRadius="14" Padding="10" ClipToBounds="True">
                      <Image Source="{Binding After}" Stretch="Uniform" />
                    </Border>
                  </StackPanel>
                </Grid>
                <StackPanel IsVisible="{Binding HasBefore, Converter={StaticResource InverseBool}}">
                  <TextBlock Text="Transparent result" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="{StaticResource MutedBrush}" />
                  <Border Background="#F3E3C7" CornerRadius="14" Padding="10" ClipToBounds="True">
                    <Image Source="{Binding After}" Stretch="Uniform" />
                  </Border>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Margin="0,14,0,0" Padding="16,13">
          <Grid IsEnabled="{Binding CanAdjustQuality}" ColumnDefinitions="Auto,170,18,Auto,130,*,Auto">
            <TextBlock Text="Quality" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ModelChoices}" SelectedValue="{Binding Model}"
                      SelectedValueBinding="{Binding Value}">
              <ToolTip.Tip><TextBlock Text="{Binding ModelDescription}" /></ToolTip.Tip>
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="Edges" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding RefinementChoices}" SelectedValue="{Binding Refinement}"
                      SelectedValueBinding="{Binding Value}">
              <ToolTip.Tip><TextBlock Text="{Binding RefinementDescription}" /></ToolTip.Tip>
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="5" Text="Newly added images use these settings." FontSize="12"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap" />
            <Button Grid.Column="6" Content="Reprocess" Command="{Binding ApplyQualityCommand}">
              <ToolTip.Tip>Reprocess selected image</ToolTip.Tip>
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FDEBC8" CornerRadius="12" Margin="0,12,0,0" Padding="13,10">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="●" FontSize="9" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#65432A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="1" Classes="card" Padding="16,17,16,14">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Queue &amp; gallery" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GallerySummary}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add" Command="{Binding ChooseImageCommand}" Classes="small" />
          </Grid>

          <Border Grid.Row="1" Background="#FFF3D8" CornerRadius="12" Padding="12,10" Margin="0,14,0,12">
            <Grid RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding QueueSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#65432A" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Classes="small" IsVisible="{Binding IsWorking}" />
              </Grid>
              <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" Margin="0,8,0,0" IsVisible="{Binding IsWorking}" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,9" Padding="7" CornerRadius="13" BorderThickness="1"
                          BorderBrush="{Binding SelectionBorderColor}" Background="{Binding SelectionBackgroundColor}">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Grid.Column="0" Margin="0" Padding="0" Background="Transparent" BorderBrush="Transparent"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{Binding SelectionAutomationName}"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectQueueItemCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="66,*">
                          <Border Width="58" Height="58" CornerRadius="10" Background="#F1DFC1" ClipToBounds="True" HorizontalAlignment="Left">
                            <Grid>
                              <TextBlock Text="✦" Foreground="#B89B78" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,7,0">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                              <TextBlock Text="●" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{Binding StatusColor}" />
                              <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar Height="3" Margin="0,6,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="1" IsVisible="{Binding IsProcessing}" />
                          </StackPanel>
                        </Grid>
                      </Button>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Copy" Classes="small"
                                Command="{Binding $parent[ItemsControl].DataContext.CopyQueueItemCommand}"
                                CommandParameter="{Binding}" IsEnabled="{Binding CanCopy}">
                          <ToolTip.Tip>Copy transparent image</ToolTip.Tip>
                        </Button>
                        <Button Content="Delete" Classes="danger"
                                Command="{Binding $parent[ItemsControl].DataContext.DeleteQueueItemCommand}"
                                CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}">
                          <ToolTip.Tip>Delete this gallery copy</ToolTip.Tip>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Grid Grid.Row="3" Margin="0,2,0,0" IsVisible="{Binding HasHiddenItems}" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Up to 100 items are shown at once." FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Newer" Command="{Binding ShowNewerItemsCommand}" Classes="small" />
            <Button Grid.Column="2" Content="Older" Command="{Binding ShowOlderItemsCommand}" Classes="small" Margin="6,0,0,0" />
          </Grid>

          <Border Grid.Row="4" Background="#FFF4D8" BorderBrush="#E9D29F" BorderThickness="1" CornerRadius="11" Padding="11,9" Margin="0,11,0,0">
            <TextBlock Text="{Binding RetentionNotice}" FontSize="11" LineHeight="16" TextWrapping="Wrap" Foreground="#725632" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
