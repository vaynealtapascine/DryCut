<Window x:Class="BackgroundCut.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BackgroundCut.Desktop.Ui"
        Title="BackgroundCut"
        MinWidth="1080" MinHeight="700" Width="1320" Height="840"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ChooseImageCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewImageCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="28,24,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Calm, compact app header. -->
        <Grid Margin="2,0,2,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="BackgroundCut" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Private background removal, right on your PC" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource GhostButton}"
                        ToolTip="Output, models, and Explorer menu"/>
                <Button Content="+  Add images" Command="{Binding ChooseImageCommand}" Style="{StaticResource PrimaryButton}"
                        ToolTip="Choose one or several images (Ctrl+O)"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- Main workspace -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" Margin="2,0,2,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedItem.Status}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Copy" Command="{Binding CopyCommand}"/>
                                <Button Content="Save" Command="{Binding SaveCommand}"/>
                                <Button Content="Save as…" Command="{Binding SaveAsCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <!-- Empty / drop target -->
                            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                                    Background="#FBFAFD" BorderBrush="#D9D4EB" BorderThickness="1" CornerRadius="16"
                                    Padding="30">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                                    <Border Width="76" Height="76" CornerRadius="24" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,20">
                                        <TextBlock Text="＋" FontSize="38" FontWeight="Light" Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Drop your images here" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add one image or a whole batch. They’ll process in order and stay in your gallery for 30 days."
                                               FontSize="15" LineHeight="23" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,10,0,18"/>
                                    <Button Content="Choose images" Command="{Binding ChooseImageCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Center" MinWidth="190"/>
                                    <TextBlock Text="JPG, PNG, WebP, BMP, or TIFF" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Waiting / processing selection -->
                            <StackPanel Visibility="{Binding ShowProcessing, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
                                <Border Width="66" Height="66" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,18">
                                    <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedItem.Status}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <ProgressBar Height="8" Margin="0,22,0,12" Value="{Binding SelectedItem.Progress, Mode=OneWay}" Maximum="1"/>
                                <TextBlock Text="{Binding QueueSummary}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                <Button Content="Cancel current image" Command="{Binding CancelCommand}" Margin="0,18,0,0"/>
                            </StackPanel>

                            <!-- Error selection -->
                            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
                                <Border Width="62" Height="62" CornerRadius="20" Background="#FFF0F3" Margin="0,0,0,18">
                                    <TextBlock Text="!" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="This image needs attention" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,14" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Try again" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Open Settings" Command="{Binding SettingsCommand}"/>
                                    <Button Content="Add other images" Command="{Binding ChooseImageCommand}"/>
                                </StackPanel>
                                <Expander Header="Technical details" Margin="0,14,0,0" MaxWidth="560"
                                          Visibility="{Binding ErrorDetails, Converter={StaticResource StringToVisibility}}">
                                    <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150"/>
                                </Expander>
                            </StackPanel>

                            <!-- Completed selection -->
                            <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0" Visibility="{Binding HasBefore, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Original" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="{StaticResource MutedBrush}"/>
                                    <Border Background="#F0F1F5" CornerRadius="14" Padding="10" ClipToBounds="True">
                                        <Image Source="{Binding Before}" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Grid.Column" Value="1"/>
                                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBefore}" Value="False">
                                                    <Setter Property="Grid.Column" Value="0"/>
                                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Transparent result" FontWeight="SemiBold" Margin="2,0,0,8" Foreground="{StaticResource MutedBrush}"/>
                                    <Border CornerRadius="14" Padding="10" ClipToBounds="True">
                                        <Border.Background>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#FAFAFC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,18,18"/></GeometryDrawing.Geometry></GeometryDrawing>
                                                        <GeometryDrawing Brush="#E7E7EC"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,9,9"/></GeometryDrawing.Geometry></GeometryDrawing>
                                                        <GeometryDrawing Brush="#E7E7EC"><GeometryDrawing.Geometry><RectangleGeometry Rect="9,9,9,9"/></GeometryDrawing.Geometry></GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Border.Background>
                                        <Image Source="{Binding After}" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Quality controls stay available but visually secondary. -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="16,13">
                    <Grid IsEnabled="{Binding CanAdjustQuality}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ModelChoices}" SelectedValue="{Binding Model}"
                                  SelectedValuePath="Value" DisplayMemberPath="Name" ToolTip="{Binding ModelDescription}"/>
                        <TextBlock Grid.Column="3" Text="Edges" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding RefinementChoices}" SelectedValue="{Binding Refinement}"
                                  SelectedValuePath="Value" DisplayMemberPath="Name" ToolTip="{Binding RefinementDescription}"/>
                        <TextBlock Grid.Column="5" Text="Newly added images use these settings." FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap"/>
                        <Button Grid.Column="6" Content="Reprocess selected" Command="{Binding ApplyQualityCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Margin="0,12,0,0" Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="●" FontSize="9" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#514B69" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Queue + gallery -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,17,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Queue &amp; gallery" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GallerySummary}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Add" Command="{Binding ChooseImageCommand}" Style="{StaticResource SmallButton}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#F7F5FC" CornerRadius="12" Padding="12,10" Margin="0,14,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding QueueSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#514B69" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SmallButton}"
                                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" Margin="0,8,0,0"
                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:QueueItemViewModel}">
                                    <Border Margin="0,0,0,9" Padding="7" CornerRadius="13" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="Background" Value="#FBFAFD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="Background" Value="#F7F4FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Margin="0" Padding="0" Background="Transparent" BorderBrush="Transparent"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="66"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="58" Height="58" CornerRadius="10" Background="#ECEBF0" ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Grid>
                                                            <TextBlock Text="✦" FontFamily="Segoe UI Symbol" Foreground="#AAA6B4" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,7,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <TextBlock Text="●" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#918C9D"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static ui:QueueItemState.Processing}">
                                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static ui:QueueItemState.Completed}">
                                                                                <Setter Property="Foreground" Value="#4F9A78"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <ProgressBar Height="3" Margin="0,6,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                                     Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="Copy" Style="{StaticResource SmallButton}"
                                                        Command="{Binding DataContext.CopyQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding CanCopy}" ToolTip="Copy transparent image"/>
                                                <Button Content="Delete" Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.DeleteQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}" ToolTip="Delete this gallery copy"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#FBF9F4" BorderBrush="#EEE7D8" BorderThickness="1" CornerRadius="11" Padding="11,9" Margin="0,11,0,0">
                        <TextBlock Text="{Binding RetentionNotice}" FontSize="11" LineHeight="16" TextWrapping="Wrap" Foreground="#716750"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
