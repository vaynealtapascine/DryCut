<Window x:Class="BackgroundCut.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BackgroundCut" MinWidth="1024" MinHeight="680" Width="1180" Height="760" Background="#F6F8FB" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding ChooseImageCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewImageCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></Window.InputBindings>
 <DockPanel Margin="32">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BackgroundCut" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Remove image backgrounds privately, right on your PC." Margin="0,4,0,0" Foreground="#51606F"/></StackPanel><Button Grid.Column="1" Content="Settings" Command="{Binding SettingsCommand}" ToolTip="Open settings (Alt+S)"/></Grid>
  <Grid>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="18" Background="White" Padding="28" AllowDrop="True">
    <Grid>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Drop an image here" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="JPG, PNG, WebP, BMP, or TIFF" FontSize="16" Foreground="#51606F" Margin="0,10,0,20" HorizontalAlignment="Center"/><Button Content="Choose image" Command="{Binding ChooseImageCommand}" IsDefault="True"/></StackPanel>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Working on it…" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/><ProgressBar Width="360" Height="10" Margin="0,24,0,12" Value="{Binding Progress}" Maximum="1"/><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Foreground="#51606F"/><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,20,0,0"/></StackPanel>
     <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Something went wrong" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="520" Margin="0,12" HorizontalAlignment="Center"/><Button Content="Try again" Command="{Binding RetryCommand}" HorizontalAlignment="Center"/></StackPanel>
     <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Before" FontWeight="SemiBold" Margin="0,0,0,8"/><Border Background="#E9EEF3" CornerRadius="10" Padding="8"><Image Source="{Binding Before}" Stretch="Uniform"/></Border></StackPanel><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="After · transparent" FontWeight="SemiBold" Margin="0,0,0,8"/><Border CornerRadius="10" Padding="8"><Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#DCE3EA"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Brush="#DCE3EA"><GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,8,8"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Border.Background><Image Source="{Binding After}" Stretch="Uniform"/></Border></StackPanel><StackPanel Grid.Column="2" Margin="20,22,0,0"><TextBlock Text="Quality" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Model" Margin="0,18,0,4"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}"/><TextBlock Text="{Binding ModelDescription}" TextWrapping="Wrap" Foreground="#51606F" Margin="0,5,0,14"/><TextBlock Text="Edge detail" Margin="0,4,0,4"/><ComboBox ItemsSource="{Binding Refinements}" SelectedItem="{Binding Refinement}"/><TextBlock Text="{Binding RefinementDescription}" TextWrapping="Wrap" Foreground="#51606F" Margin="0,5,0,20"/></StackPanel></Grid>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#51606F"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="New image" Command="{Binding NewImageCommand}"/><Button Content="Copy" Command="{Binding CopyCommand}"/><Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True"/><Button Content="Save as…" Command="{Binding SaveAsCommand}" Background="#2563EB" Foreground="White"/></StackPanel></Grid>
  </Grid>
 </DockPanel>
</Window>
